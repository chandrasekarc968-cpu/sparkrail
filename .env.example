# .env.example
# Security Notice: Do not commit the actual .env file to version control.
# Copy this file to .env and replace the values appropriately.

# Database URL (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/railway_db

# Kafka Brokers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# Optional XGBoost Artifact Path (Must be a valid path if enabled)
XGB_MODEL_PATH=models/tci_degradation_xgb.model
