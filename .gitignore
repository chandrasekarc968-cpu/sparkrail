# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Environments and secrets
.env
.env.*
!.env.example
*.local
venv/
.venv/
env/

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example

# Runtime and generated outputs (do not commit dynamic schedule / kpi outputs)
data/schedule_output.json
data/kpi_report.json
*.log

# Keep scenario fixture tracked
!data/synthetic/scenario.json

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Playwright E2E test results, reports, and media
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
playwright/.cache/
*.log
/tmp/*.log
